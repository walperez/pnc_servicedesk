# Required environment variables for both agents
# Copy this file to .env and fill in your values.
# Never commit this file to source control.

# -------------------------------------------------------
# 1E DEX Telemetry Agent
# -------------------------------------------------------
# Your 1E tenant subdomain (e.g., for contoso.1e.com, set: contoso)
DEX_TENANT=your-tenant

# API Key from the 1E console: Settings > API Keys
DEX_API_KEY=your-dex-api-key

# -------------------------------------------------------
# Microsoft Intune Management Agent (via Microsoft Graph)
# -------------------------------------------------------
# Entra ID (Azure AD) tenant ID — found in Entra ID > Overview
AZURE_TENANT_ID=your-azure-tenant-id

# App registration client ID — found in Entra ID > App registrations > your app > Overview
AZURE_CLIENT_ID=your-app-client-id

# Client secret value — found in Entra ID > App registrations > your app > Certificates & secrets
# Note: secrets expire — set a reminder to rotate before expiry
AZURE_CLIENT_SECRET=your-client-secret-value
